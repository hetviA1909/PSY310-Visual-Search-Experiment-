            <CodeComponent name="cod" plugin="None">
                <Param name="name" val="cod" valType="code" updates="None" plugin="None"/>
                <Param name="Code Type" val="Auto-&gt;JS" valType="str" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="Before Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Routine" val="if random()&gt;0.5:&#13;&#10;    num_distra = 10&#13;&#10;    thisExp.addData('num_distra', num_distra)&#13;&#10;else:&#13;&#10;    num_distra = 5&#13;&#10;    thisExp.addData('num_distr', num_distra)&#13;&#10;distractors = []&#13;&#10;&#13;&#10;for i in range(num_distra):&#13;&#10;&#13;&#10;    distra = visual.TextStim(win=win, name='distra',&#13;&#10;        text='L',&#13;&#10;        font='Open Sans',&#13;&#10;        pos=(random()-0.5, random()-0.5), height=0.1, wrapWidth=None, ori=randint(0,360), &#13;&#10;        color='white', colorSpace='rgb', opacity=None, &#13;&#10;        languageStyle='LTR',&#13;&#10;        depth=0.0);&#13;&#10;        &#13;&#10;    distractors.append(distra)&#13;&#10;    &#13;&#10;    &#13;&#10;for distra in distractors:&#13;&#10;    distra.setAutoDraw(True)" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Routine" val="for distra in distractors:&#13;&#10;    distra.setAutoDraw(False)&#13;&#10;    " valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Routine" val="if ((Math.random() &gt; 0.5)) {&#10;    num_distra = 10;&#10;    psychoJS.experiment.addData(&quot;num_distra&quot;, num_distra);&#10;} else {&#10;    num_distra = 5;&#10;    psychoJS.experiment.addData(&quot;num_distr&quot;, num_distra);&#10;}&#10;distractors = [];&#10;for (var i, _pj_c = 0, _pj_a = util.range(num_distra), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&#10;    i = _pj_a[_pj_c];&#10;    distra = new visual.TextStim({&quot;win&quot;: psychoJS.window, &quot;name&quot;: &quot;distra&quot;, &quot;text&quot;: &quot;L&quot;, &quot;font&quot;: &quot;Open Sans&quot;, &quot;pos&quot;: [(Math.random() - 0.5), (Math.random() - 0.5)], &quot;height&quot;: 0.1, &quot;wrapWidth&quot;: null, &quot;ori&quot;: util.randint(0, 360), &quot;color&quot;: &quot;white&quot;, &quot;colorSpace&quot;: &quot;rgb&quot;, &quot;opacity&quot;: null, &quot;languageStyle&quot;: &quot;LTR&quot;, &quot;depth&quot;: 0.0});&#10;    distractors.push(distra);&#10;}&#10;for (var distra, _pj_c = 0, _pj_a = distractors, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&#10;    distra = _pj_a[_pj_c];&#10;    distra.setAutoDraw(true);&#10;}&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each JS Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Routine" val="for (var distra, _pj_c = 0, _pj_a = distractors, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&#10;    distra = _pj_a[_pj_c];&#10;    distra.setAutoDraw(false);&#10;}&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
            </CodeComponent>
